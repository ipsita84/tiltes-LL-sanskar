Cell[CellGroupData[{

Cell["negative B", "Subsection",
 CellChangeTimes->{{3.982384115344654*^9, 
  3.9823841172614717`*^9}},ExpressionUUID->"b8b167fe-b33c-44f4-9326-\
10de05066d8b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Bval", "=", 
   RowBox[{
    RowBox[{"-", "1"}], "*", 
    RowBox[{"10", "^", 
     RowBox[{"(", "2", ")"}]}]}]}], ";", 
  RowBox[{"etaval", "=", "0"}], ";", 
  RowBox[{"kxval", "=", 
   RowBox[{"N", "[", 
    RowBox[{"2", "\[Pi]", "*", "0.00001"}], "]"}]}], ";", 
  RowBox[{"a0val", "=", "1"}], ";", 
  RowBox[{"vxval", "=", "0.0004"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ratval", "=", "1"}], ";", 
  RowBox[{"ylim", "=", 
   RowBox[{"ysg", "[", 
    RowBox[{"1", ",", "kxval", ",", "Bval"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"int", ",", "norm", ",", "vec", ",", "limi", ",", "lim"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"\t", 
  RowBox[{
   RowBox[{
    RowBox[{"vec", "[", 
     RowBox[{"n_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Phi]A", "[", 
        RowBox[{"a0val", ",", "vxval", ",", "y", ",", 
         RowBox[{"(*", "\[Xi]", "*)"}], "1", ",", "kxval", ",", "Bval", ",", 
         " ", "n", ",", "ratval"}], "]"}], ",", 
       RowBox[{"\[Phi]B", "[", 
        RowBox[{"a0val", ",", "y", ",", 
         RowBox[{"(*", "\[Xi]", "*)"}], "1", ",", "kxval", ",", "Bval", ",", 
         " ", "n", ",", "ratval"}], "]"}]}], "}"}], 
     RowBox[{"HeavisideTheta", "[", 
      RowBox[{
       RowBox[{"Sign", "[", "Bval", "]"}], 
       RowBox[{"(", 
        RowBox[{"ylim", "-", "y"}], ")"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"norm", "[", "n_", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"int", ",", "yvar", ",", 
        RowBox[{"limi", "=", 
         RowBox[{"Abs", "[", 
          RowBox[{"ysg", "[", 
           RowBox[{"1", ",", "kxval", ",", "Bval"}], "]"}], "]"}]}]}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"int", "=", 
        RowBox[{"Quiet", "[", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Conjugate", "[", 
             RowBox[{"vec", "[", 
              RowBox[{"n", ",", "yvar"}], "]"}], "]"}], ".", 
            RowBox[{"vec", "[", 
             RowBox[{"n", ",", "yvar"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"yvar", ",", 
             RowBox[{
              RowBox[{"-", "2"}], "limi"}], ",", 
             RowBox[{"2", "limi"}]}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Sqrt]", "int"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lim", "=", 
   RowBox[{"2", 
    RowBox[{"Abs", "[", "ylim", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x2", ",", "x3", ",", "x4"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"norm", "[", "1", "]"}], ",", 
     RowBox[{"norm", "[", "2", "]"}], ",", 
     RowBox[{"norm", "[", "30", "]"}]}], "}"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"LogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"(*", "*)"}], 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", 
        RowBox[{"vec", "[", 
         RowBox[{"1", ",", "y"}], "]"}], "]"}], ".", 
       RowBox[{"vec", "[", 
        RowBox[{"1", ",", "y"}], "]"}]}], "/", "x2"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", 
        RowBox[{"vec", "[", 
         RowBox[{"2", ",", "y"}], "]"}], "]"}], ".", 
       RowBox[{"vec", "[", 
        RowBox[{"2", ",", "y"}], "]"}]}], "/", "x3"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}], "Input",
