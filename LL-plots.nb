Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"**", "**", "**", "using"}], " ", "a", " ", "smooth", " ", 
     "curoff", " ", "rther", " ", "than", " ", "hard", " ", "cut"}], "-", 
    "off"}], " ", "*******)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Bval", "=", 
     RowBox[{"1.0", 
      RowBox[{"(*", " ", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}]}], "*)"}], 
      RowBox[{"10", "^", 
       RowBox[{"(", "2", ")"}]}]}]}], ";", 
    RowBox[{"kxval", "=", 
     RowBox[{"N", "[", 
      RowBox[{"2", "\[Pi]", " ", "*", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"-", "0"}], ")"}]}]}], "]"}]}], ";", 
    RowBox[{"a0val", "=", "1"}], ";", 
    RowBox[{"vxval", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ratval", "=", "9"}], ";", 
    RowBox[{"ylim", "=", 
     RowBox[{"ysg", "[", 
      RowBox[{"1", ",", "kxval", ",", "Bval"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"fna", ",", "int", ",", "norm", ",", "vec"}], "]"}], ";"}], "\[IndentingNewLine]",
    "\t", 
   RowBox[{
    RowBox[{
     RowBox[{"vec", "[", 
      RowBox[{"n_", ",", "y_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Phi]A", "[", 
         RowBox[{"a0val", ",", "vxval", ",", "y", ",", 
          RowBox[{"(*", "\[Xi]", "*)"}], "1", ",", "kxval", ",", "Bval", ",", 
          " ", "n", ",", "ratval"}], "]"}], ",", 
        RowBox[{"\[Phi]B", "[", 
         RowBox[{"a0val", ",", "y", ",", 
          RowBox[{"(*", "\[Xi]", "*)"}], "1", ",", "kxval", ",", "Bval", ",", 
          " ", "n", ",", "ratval"}], "]"}]}], "}"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"Erf", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sign", "[", "Bval", "]"}]}], 
            RowBox[{"(", 
             RowBox[{"y", "-", " ", "ylim"}], ")"}]}], "]"}]}], ")"}], "/", 
        "2"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"norm", "[", "n_", "]"}], ":=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"int", ",", "yvar", ",", 
         RowBox[{"lim", "=", 
          RowBox[{"ysg", "[", 
           RowBox[{"1", ",", "kxval", ",", "Bval"}], "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"int", "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Conjugate", "[", 
              RowBox[{"vec", "[", 
               RowBox[{"n", ",", "yvar"}], "]"}], "]"}], ".", 
             RowBox[{"vec", "[", 
              RowBox[{"n", ",", "yvar"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"yvar", ",", 
              RowBox[{
               RowBox[{"-", "2"}], "lim"}], ",", 
              RowBox[{"2", "lim"}]}], "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Sqrt]", "int"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lim", "=", 
     RowBox[{"20", " ", "ylim"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"norm", "[", "0", "]"}], ",", 
      RowBox[{"norm", "[", "1", "]"}], ",", 
      RowBox[{"norm", "[", "2", "]"}], ",", 
      RowBox[{"norm", "[", "3", "]"}]}], "}"}]}], "\[IndentingNewLine]", 
   RowBox[{"LogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"(*", "*)"}], 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", 
          RowBox[{"vec", "[", 
           RowBox[{"0", ",", "y"}], "]"}], "]"}], ".", 
         RowBox[{"vec", "[", 
          RowBox[{"0", ",", "y"}], "]"}]}], "/", "x1"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", 
          RowBox[{"vec", "[", 
           RowBox[{"1", ",", "y"}], "]"}], "]"}], ".", 
         RowBox[{"vec", "[", 
          RowBox[{"1", ",", "y"}], "]"}]}], "/", "x2"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", 
          RowBox[{"vec", "[", 
           RowBox[{"2", ",", "y"}], "]"}], "]"}], ".", 
         RowBox[{"vec", "[", 
          RowBox[{"2", ",", "y"}], "]"}]}], "/", "x3"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", 
          RowBox[{"vec", "[", 
           RowBox[{"3", ",", "y"}], "]"}], "]"}], ".", 
         RowBox[{"vec", "[", 
          RowBox[{"3", ",", "y"}], "]"}]}], "/", "x4"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "Automatic"}], ",", 
     RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}]}]], "Input",
