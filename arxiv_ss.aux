\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Relative deviations $\delta _{\rm  M}$ and $\delta _{\rm  WF}$ of the Mott relation and the Wiedemann-Franz law, as functions of $a_0^2\,e\,\mathcal  B$ and of the temperature $T$ in millikelvin, for $\xi =+$, $v_y/v_x=0.8$, $\eta _x=0.3$, $a_0\,|k_x|\le 0.3$ and $10^{-3}\le \tilde  \mu \le 3\times 10^{-3}$. The value $T=1$ mK corresponds to $1.86\times 10^{-8}$ in units of $v_x/a_0$, and $\mathcal  B$ is obtained from $a_0^2\,e\,\mathcal  B$ on restoring $\hbar /(e\,a_0^2)\simeq 3.3\times 10^{4}$ T. Energies are in units of $v_x/a_0$, and $\Delta E$ is the spacing between the levels $n=1$ and $n=2$ at $k_x=0$.}}{11}{table.1}\protected@file@percent }
\newlabel{tabdev}{{I}{11}{Relative deviations $\delta _{\rm M}$ and $\delta _{\rm WF}$ of the Mott relation and the Wiedemann-Franz law, as functions of $a_0^2\,e\,\mathcal B$ and of the temperature $T$ in millikelvin, for $\xi =+$, $v_y/v_x=0.8$, $\eta _x=0.3$, $a_0\,|k_x|\le 0.3$ and $10^{-3}\le \tilde \mu \le 3\times 10^{-3}$. The value $T=1$ mK corresponds to $1.86\times 10^{-8}$ in units of $v_x/a_0$, and $\mathcal B$ is obtained from $a_0^2\,e\,\mathcal B$ on restoring $\hbar /(e\,a_0^2)\simeq 3.3\times 10^{4}$ T. Energies are in units of $v_x/a_0$, and $\Delta E$ is the spacing between the levels $n=1$ and $n=2$ at $k_x=0$}{table.1}{}}
